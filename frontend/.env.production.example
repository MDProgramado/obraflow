# ===========================================
# Frontend Production Environment Variables (Vercel)
# ===========================================
# Configure em Vercel > Project > Settings > Environment Variables (Production).
# Depois de alterar qualquer variavel, faca um novo deploy: NEXT_PUBLIC_* e o
# rewrite do next.config.mjs sao fixados no momento do build.

# Backend API
# Origem apenas, SEM /api/v1 e SEM barra no final.
# Ex.: https://obraflow-backend.onrender.com
BACKEND_URL=https://your-backend-domain.com

# NextAuth
# URL publica do frontend (dominio Vercel ou custom domain), sem barra no final.
NEXTAUTH_URL=https://your-frontend-domain.com
# Gere com: openssl rand -base64 32   (minimo 32 caracteres)
NEXTAUTH_SECRET=your-super-secure-nextauth-secret-here-min-32-chars

# Next.js (opcional: nao referenciada no codigo atualmente)
NEXT_PUBLIC_APP_URL=https://your-frontend-domain.com

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Feature Flags
# NEXT_PUBLIC_ENABLE_PWA=true
# NEXT_PUBLIC_ENABLE_DARK_MODE=true
